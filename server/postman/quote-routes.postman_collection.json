{
  "info": {
    "_postman_id": "machinematch-quote-v1",
    "name": "MachineMatch B2B Quote Request API",
    "description": "Postman Collection for testing B2B Buyer Quote Requests, Vendor Lead Dashboard, and Status Transitions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Quote Requests",
      "item": [
        {
          "name": "1. Submit Quote Request (Buyer / Guest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"<VENDOR_UUID>\",\n  \"contactName\": \"Vikram Sharma\",\n  \"contactPhone\": \"+91-9876543210\",\n  \"contactEmail\": \"vikram@infraconstruction.com\",\n  \"companyName\": \"Infra InfraCorp Ltd\",\n  \"message\": \"Requesting bulk pricing for 2 units of Caterpillar 320D3 excavators.\",\n  \"preferredFinancing\": true,\n  \"items\": [\n    {\n      \"machineId\": \"<MACHINE_UUID>\",\n      \"quantity\": 2,\n      \"requestedPrice\": 3600000.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["quotes"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Buyer Quote Submissions (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes/my-quotes",
              "host": ["{{baseUrl}}"],
              "path": ["quotes", "my-quotes"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Vendor Lead Quotes (Vendor/Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes/vendor/<VENDOR_UUID>",
              "host": ["{{baseUrl}}"],
              "path": ["quotes", "vendor", "<VENDOR_UUID>"]
            }
          },
          "response": []
        },
        {
          "name": "4. Update Quote Lead Status (Vendor/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"responded\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotes/<QUOTE_UUID>/status",
              "host": ["{{baseUrl}}"],
              "path": ["quotes", "<QUOTE_UUID>", "status"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
