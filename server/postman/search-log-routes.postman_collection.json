{
  "info": {
    "_postman_id": "machinematch-search-log-v1",
    "name": "MachineMatch Search Analytics API",
    "description": "Postman Collection for testing Search Query Logging, Popular Searches, and Admin Analytics Dashboards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Search Analytics",
      "item": [
        {
          "name": "1. Log Search Query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queryText\": \"20-ton excavator under ₹40 lakh with good fuel efficiency\",\n  \"searchType\": \"nlp_ai\",\n  \"parsedFilters\": {\n    \"max_price\": 4000000,\n    \"operating_weight_min\": 19000,\n    \"operating_weight_max\": 22000\n  },\n  \"resultCount\": 3,\n  \"executionTimeMs\": 145\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/search-analytics",
              "host": ["{{baseUrl}}"],
              "path": ["search-analytics"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Popular Searches (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search-analytics/popular?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["search-analytics", "popular"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Analytics Summary (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search-analytics/summary",
              "host": ["{{baseUrl}}"],
              "path": ["search-analytics", "summary"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
