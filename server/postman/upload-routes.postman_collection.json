{
  "info": {
    "_postman_id": "machinematch-upload-v1",
    "name": "MachineMatch Upload & OCR Pipeline API",
    "description": "Postman Collection for testing Brochure PDF & Image Uploads, processing pipeline state, and uploader history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Uploads Pipeline",
      "item": [
        {
          "name": "1. Upload File (PDF / Image)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads",
              "host": ["{{baseUrl}}"],
              "path": ["uploads"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get My Upload History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/uploads/my-uploads",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "my-uploads"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Pending OCR Uploads (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/uploads/pending",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "pending"]
            }
          },
          "response": []
        },
        {
          "name": "4. Update OCR Processing Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"processed\",\n  \"ocrExtractedData\": {\n    \"operating_weight\": \"21000 kg\",\n    \"engine_power\": \"110 kW\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/<UPLOAD_UUID>/status",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "<UPLOAD_UUID>", "status"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
